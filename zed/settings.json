// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "Cursor": {
      "type": "custom",
      "command": "~/.local/bin/agent",
      "args": ["acp"],
    },
  },
  "theme_overrides": {
    "Ayu Mirage": {
      "version_control.conflict_marker.ours": "#a1c18126",
      "version_control.conflict_marker.theirs": "#74ade826",
    },
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "hide_gitignore": false,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "format_on_save": "on",
  "wrap_guides": [80, 100],
  "relative_line_numbers": "disabled",
  "always_treat_brackets_as_autoclosed": true,
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "enable_feedback": false,
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "buffer_font_family": "MonaspiceXe Nerd Font",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Mirage",
  },
  "languages": {
    "JSON": {
      "auto_indent": "none",
      "tab_size": 4,
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "mdformat",
          "arguments": ["--wrap", "80", "--number", "--compact-tables", "-"],
        },
      },
    },
    "GraphQL": {
      "format_on_save": "off",
    },
    "YAML": {
      "formatter": "language_server",
      "format_on_save": "off",
    },

    "Go": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "golangci-lint",
          "arguments": ["fmt", "--config", "./.golangci.yml", "--stdin"],
        },
      },
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "language_servers": ["gopls", "golangci-lint", "..."],
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          // Change `--indent 2` to match your preferred tab_size
          "arguments": ["--filename", "{buffer_path}", "--indent", "4"],
        },
      },
    },
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        // Wrapper derives a temp config from the discovered .golangci.yml with
        // relative-path-mode=gomod (required so the langserver can match issue
        // paths in go.work monorepos) + exhaustive enabled. Nothing is
        // committed; see ~/.config/zed/gci-lsp.sh. The langserver execs this
        // without a shell, so bash expands $HOME and forwards appended args.
        "command": [
          "bash",
          "-c",
          "exec \"$HOME/.config/zed/gci-lsp.sh\" \"$@\"",
          "gci-lsp",
        ],
      },
    },
  },
}
