CURRENT_DIR=${${(%):-%x}:A:h}
# Repo scripts (used by git aliases in .gitconfig.local)
export PATH="${CURRENT_DIR:h}/scripts:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Mise
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
else
  echo "zshrc.local: mise not installed" >&2
fi


# Aliases
source "$CURRENT_DIR/.aliases.local"
