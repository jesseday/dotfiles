CURRENT_DIR=${${(%):-%x}:A:h}
# Repo executables (git-* files here become git subcommands, e.g. `git del`)
export PATH="${CURRENT_DIR:h}/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Mise
export PATH="$HOME/.local/bin:$PATH"
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
else
  echo "zshrc.local: mise not installed" >&2
fi


# Aliases
source "$CURRENT_DIR/.aliases.local"
